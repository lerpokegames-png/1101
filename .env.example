# Copie este arquivo como ".env" (na mesma pasta do script) e preencha com
# as suas chaves. O .env está no .gitignore - nunca versione as chaves.

# Qual canal produzir: "algoritmo_oculto" (documentário forense animado sobre
# cobranças abusivas, PT-BR - o canal novo) ou "empresas" (o nicho original).
# Tudo que muda entre eles está no dicionário NICHOS do pipeline.
NICHO=algoritmo_oculto

# Obrigatória se USAR_NUVEM = True -> console.groq.com/keys (grátis)
GROQ_API_KEY=

# Busca de b-roll -> pexels.com/api (grátis)
PEXELS_API_KEY=

# Usada pelo agente de referência do pipeline E pelo raio_x_canal.py
# (que disseca um canal inteiro: formato, ritmo, títulos, top por views).
# Gratuita -> console.cloud.google.com
# (ative a "YouTube Data API v3" e crie uma credencial do tipo Chave de API)
YOUTUBE_API_KEY=

# Narração (pago por caractere depois da cota gratuita).
# Sem estas duas, o pipeline só pula a etapa de áudio.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
